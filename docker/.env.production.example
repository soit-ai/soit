# Production environment for docker/docker-compose.production.yml.
#
# Copy to docker/.env.production, fill in every required value, then:
#   docker compose --env-file docker/.env.production \
#     -f docker/docker-compose.production.yml config --quiet
#   docker compose --env-file docker/.env.production \
#     -f docker/docker-compose.production.yml up -d
#
# Required values have no default; compose refuses to start without them.
# Never commit the filled-in copy.

# --- Required ------------------------------------------------------------

# Public hostname the TLS gateway serves (a DNS name pointing at this host).
SOIT_PUBLIC_HOSTNAME=

# Managed PostgreSQL. Size max_connections for every process's pool; see
# docs/operations/database-connections.md.
DATABASE_URL=postgresql://soit:CHANGE_ME@db.internal:5432/soit

# Redis for cache and queues, and the Redis event bus (can be the same server;
# the bus uses pub/sub channels, which are not database-scoped).
REDIS_URL=redis://redis.internal:6379/0
EVENT_BUS_REDIS_URL=redis://redis.internal:6379/0

# JWT signing key: a long random string, never the placeholder.
SECRET_KEY=

# External Vault (not dev mode).
VAULT_URL=https://vault.internal:8200
VAULT_TOKEN=

# Object storage options for the fsspec backend, as JSON.
STORAGE_OPTIONS_JSON={"key": "", "secret": "", "client_kwargs": {"endpoint_url": "https://s3.internal"}}

# Vector store host.
MILVUS_HOST=milvus.internal

# Trusted Ed25519 public keys for plugin packages, as a JSON list.
PLUGIN_SIGNATURE_PUBLIC_KEYS=[]

# --- Capacity ------------------------------------------------------------

# API processes (uvicorn --workers). The API only enqueues and tails chats.
API_WORKERS=4

# Per-process connection pool. Every API worker and every worker process
# holds its own.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Chats one response-worker process executes at once. Capped in code at
# pool + overflow - 4; for more capacity add response-worker replicas.
RESPONSE_INTERACTION_WORKER_CONCURRENCY=24

# --- Optional ------------------------------------------------------------

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

SYSTEM_MAIL_ENABLED=false
SYSTEM_MAIL_URL=
SYSTEM_MAIL_LINK_BASE_URL=

SCHEDULE_WORKER_POLL_INTERVAL=15

STORAGE_BACKEND=s3
MILVUS_PORT=19530

PLUGIN_REVOKED_PACKAGE_DIGESTS=[]
EGRESS_ALLOWLIST=[]
EGRESS_BLOCKLIST=[]

# Addresses or CIDR ranges of the TLS gateway in front of the API, e.g. the
# compose network's subnet (docker network inspect). X-Forwarded-For is read
# only from these, so API key address allowlists see the real client. Leave
# empty if no key uses an address allowlist.
TRUSTED_PROXIES=[]

OTEL_SERVICE_NAME=soit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_TRACES_SAMPLE_RATIO=0.1

# builtin matches credentials and identifiers in process; http sends content
# to a classifier you operate at CONTENT_SAFETY_ENDPOINT.
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_PROVIDER=builtin
CONTENT_SAFETY_SECRET_ACTION=redact
CONTENT_SAFETY_PII_ACTION=observe
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_FAIL_CLOSED=true

# Model provider keys; configure providers in the console instead when you can.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Paths to the gateway and collector configuration, relative to docker/.
CADDYFILE_PATH=./production/Caddyfile
OTEL_COLLECTOR_CONFIG=./production/otel-collector.yaml
