{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    // "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./app/*"],
      "ui/*": ["./app/components/ui/*"],
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  // app/routes_old is the pre-rebuild tree, kept for one release so anything the
  // console has not absorbed is recoverable from the working tree rather than
  // only from history. It is not registered and not compiled; its pages
  // reference generated route types that no longer exist.
  "exclude": ["node_modules", "app/routes_old"]
}
