# Application Environment Variables
# Copy this file to .env or .env.local and update with your actual values

PROJECT_NAME="soit"
PROJECT_DESCRIPTION="SOIT is a platform for llm application building"

# ============================================
# Database Configuration
# ============================================
# Database type (postgresql, mysql, etc.)
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=soit_db
DATABASE_USER=your_username
DATABASE_PASS=your_password

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Milvus Configuration
# ============================================
# Milvus vector database host
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# MinIO / S3 Configuration
# ============================================
# MinIO endpoint URL (e.g., http://localhost:9000)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=soit-artifacts
MINIO_SECURE=false

# ============================================
# Vault Configuration
# ============================================
# HashiCorp Vault URL (optional)
VAULT_URL=
VAULT_TOKEN=

# ============================================
# Observability Configuration
# ============================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=
SENTRY_ENABLED=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Plugins Configuration
# ============================================
# Filesystem directory for plugin packages
PLUGINS_DIR=./var/plugins

# ============================================
# Feature Flags
# ============================================
# Enable egress policy (deny-by-default)
ENABLE_EGRESS_POLICY=true

# ============================================
# API Configuration
# ============================================
# API v1 prefix
API_V1_PREFIX=/api/v1
