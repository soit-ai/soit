# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run the demo for this project.
# ------------------------------------------------------------------------------
PROJECT_NAME="soit-api"
PROJECT_DESCRIPTION="soit-aoi is llm plugin system"
# Environment: local, staging, production
ENVIRONMENT=local

# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5200,https://localhost,https://localhost:5200"

# Security
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=a1b2c3d4aaa

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_soit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=abc123

# Storage Configuration
# Storage type: local, s3, gcs, oss, cos
STORAGE_TYPE=local

# Local storage configuration
# No additional configuration needed for local storage

# S3 storage configuration
# STORAGE_TYPE=s3
# STORAGE_CONFIG={"bucket": "your-bucket", "region": "us-east-1", "access_key": "your-access-key", "secret_key": "your-secret-key"}

# GCS storage configuration
# STORAGE_TYPE=gcs
# STORAGE_CONFIG={"bucket": "your-bucket", "credentials_path": "/path/to/credentials.json"}

# OSS storage configuration
# STORAGE_TYPE=oss
# STORAGE_CONFIG={"bucket": "your-bucket", "endpoint": "oss-cn-hangzhou.aliyuncs.com", "access_key": "your-access-key", "secret_key": "your-secret-key"}

# COS storage configuration
# STORAGE_TYPE=cos
# STORAGE_CONFIG={"bucket": "your-bucket", "region": "ap-guangzhou", "secret_id": "your-secret-id", "secret_key": "your-secret-key"}
