  "description": "Immutable DAG workflow specification with node IO schemas. Variable references use template syntax like {{ inputs.query }} and {{ steps.node_id.output.field }}.",
  "examples": [
    {
      "name": "RAG Answer",
      "inputs_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      },
      "nodes": [
        {
          "id": "r1",
          "type": "retrieve",
          "input": {
            "query": "{{ inputs.query }}"
          }
        },
        {
          "id": "m1",
          "type": "llm",
          "input": {
            "prompt": "Answer with citations.\\n{{ steps.r1.output.context }}"
          }
        },
        {
          "id": "o1",
          "type": "output",
          "input": {
            "text": "{{ steps.m1.output.text }}",
            "citations": "{{ steps.r1.output.citations }}"
          }
        }
      ],
      "edges": [
        {
          "from": "r1",
          "to": "m1"
        },
        {
          "from": "m1",
          "to": "o1"
        }
      ],
      "outputs": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$id": "https://soit.ai/specs/v1/workflow_spec.schema.json",
  "$comment": "SOIT kernel spec schema (v1)."
