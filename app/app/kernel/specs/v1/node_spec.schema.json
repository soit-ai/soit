{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowNodeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "adapter",
    "input_schema",
    "output_schema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapter": {
      "type": "string",
      "enum": [
        "tool",
        "builtin"
      ]
    },
    "tool_ref": {
      "$ref": "refs.schema.json#/$defs/ToolRef"
    },
    "node_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "llm",
        "tool",
        "condition",
        "set_var",
        "http",
        "retrieve",
        "transform",
        "output",
        null
      ],
      "description": "Builtin workflow node type when adapter is 'builtin'."
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "policy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max_retries": {
              "type": "integer",
              "minimum": 0
            },
            "backoff_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "id": {
      "$ref": "refs.schema.json#/$defs/NodeRef",
      "type": [
        "string",
        "null"
      ],
      "description": "Stable workflow node reference."
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Node spec version (SemVer recommended).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$"
    }
  },
  "description": "Workflow node specification, currently backed by tool adapter.",
  "examples": [
    {
      "name": "health_check",
      "id": "node:tool:health_check",
      "adapter": "tool",
      "tool_ref": "tool:http:health_check",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "policy": {
        "timeout_ms": 10000,
        "retry": {
          "max_retries": 1,
          "backoff_ms": 200
        }
      }
    },
    {
      "name": "llm_chat",
      "id": "node:builtin:llm_chat",
      "adapter": "builtin",
      "node_type": "llm",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {"type": "string"},
          "model": {"type": "string"}
        },
        "required": ["prompt"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "model": {"type": "string"}
        },
        "required": ["text"]
      }
    }
  ],
  "$id": "https://soit.ai/specs/v1/node_spec.schema.json",
  "$comment": "SOIT kernel spec schema (v1).",
  "allOf": [
    {
      "title": "Tool-backed node",
      "if": {
        "properties": {
          "adapter": {
            "const": "tool"
          }
        }
      },
      "then": {
        "required": [
          "adapter",
          "tool_ref"
        ]
      }
    },
    {
      "title": "Builtin node",
      "if": {
        "properties": {
          "adapter": {
            "const": "builtin"
          }
        }
      },
      "then": {
        "required": [
          "adapter",
          "node_type"
        ]
      }
    }
  ]
}
