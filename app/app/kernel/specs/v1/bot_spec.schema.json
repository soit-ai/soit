{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soit.ai/specs/v1/bot_spec.schema.json",
  "$comment": "SOIT bot runtime spec (v1).",
  "title": "BotSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "chat"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "const": "bot_runtime_v1"
    },
    "chat": {
      "$ref": "chat_spec.schema.json"
    },
    "triggers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "webhook": {
          "type": [
            "object",
            "null"
          ]
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ]
        },
        "event": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "channels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "slack": {
          "type": [
            "object",
            "null"
          ]
        },
        "wecom": {
          "type": [
            "object",
            "null"
          ]
        },
        "telegram": {
          "type": [
            "object",
            "null"
          ]
        },
        "email": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
