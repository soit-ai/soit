{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "workspace_id",
    "dataset_id",
    "document_id",
    "document_version",
    "chunk_no",
    "section_path",
    "bbox_json",
    "source_meta_json",
    "index_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_version": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_no": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "text_preview": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "text_artifact_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "end_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "page_no": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bbox_json": {
      "type": "object"
    },
    "source_meta_json": {
      "type": "object"
    },
    "char_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "token_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "embedding_model_ref": {
      "type": [
        "string",
        "null"
      ],
      "allOf": [
        {
          "$ref": "refs.schema.json#/$defs/ModelRef"
        }
      ]
    },
    "vector_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "indexed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "index_status": {
      "type": "string",
      "enum": [
        "pending",
        "indexed",
        "failed"
      ]
    },
    "index_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}