# Application Environment Variables
# Copy this file to .env or .env.local and update with your actual values

PROJECT_NAME="soit"
PROJECT_DESCRIPTION="SOIT is a platform for llm application building"
ENVIRONMENT=development

# ============================================
# Database Configuration
# ============================================
# Database type (postgresql, mysql, etc.)
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=soit_db
DATABASE_USER=your_username
DATABASE_PASS=your_password
# Connections one process keeps open, and how many more it may open under
# load. Every API worker and worker process holds its own pool; size
# PostgreSQL max_connections for processes x (pool + overflow), see
# docs/operations/database-connections.md.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
# How long one access token lasts. The client renews silently against
# /refresh, so this is not the session length -- it is the worst-case delay
# before a revoked session stops working. Keep it short.
#
# REFRESH_TOKEN_EXPIRE_DAYS is the session length: how long a client can keep
# renewing before signing in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The instance's own mail: password resets, invitations, address confirmation.
# Off by default, and each of those features reports itself unavailable rather
# than accepting a request nothing will deliver. The URL is an Apprise target
# (mailto:// covers SMTP) and carries credentials, so it is never logged.
SYSTEM_MAIL_ENABLED=false
SYSTEM_MAIL_URL=
# Where mailed links point. Behind a proxy the request's own host is an
# internal name, so set the address people actually reach.
SYSTEM_MAIL_LINK_BASE_URL=

# ============================================
# Vector Store Configuration
# ============================================
# Backend: "milvus" or "pgvector". "pgvector" keeps each collection as a table
# in PostgreSQL, so local development can use an existing PostgreSQL with the
# pgvector extension instead of running Milvus. Production runs "milvus".
VECTOR_BACKEND=milvus
# PostgreSQL URL for the vector store (VECTOR_BACKEND=pgvector).
# Empty falls back to DATABASE_URL.
PGVECTOR_URL=
# Schema holding the pgvector collection tables
PGVECTOR_SCHEMA=vector_store

# ============================================
# Milvus Configuration
# ============================================
# Vector store mode: "server" for a Milvus deployment, "lite" for Milvus Lite.
# "lite" is a local debugging switch: it runs the embedded engine against a
# file, so knowledge and retrieval work without the milvus/etcd/minio
# containers. Single process, no Windows build (use WSL), rejected in
# production.
MILVUS_MODE=server
# Milvus vector database host (MILVUS_MODE=server)
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Milvus Lite database file (MILVUS_MODE=lite), relative to server/
MILVUS_LITE_FILE=./.milvus/soit_lite.db

# ============================================
# Storage Configuration
# ============================================
# S3 STORAGE_OPTIONS_JSON (e.g., {"endpoint_url":"http://minio:9000","key":"soitminio","secret":"soitminio"})
STORAGE_URL=file:///var/soit_storage
STORAGE_OPTIONS_JSON={}
STORAGE_AUTO_MKDIR=true

# ============================================
# Vault Configuration
# ============================================
# HashiCorp Vault URL (optional)
VAULT_URL=
VAULT_TOKEN=

# ============================================
# Observability Configuration
# ============================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=
SENTRY_ENABLED=false


# OpenTelemetry Configuration
OTEL_ENABLED=false
OTEL_SERVICE_NAME=soit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLE_RATIO=1.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=rich
LOG_COLOR=true
LOG_COLOR_FORCE=true

# ============================================
# LLM Provider Configuration
# ============================================
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_LLM_PROVIDER=openai
# Model for LLM-as-judge regression scoring; empty disables the judge
EVALUATION_JUDGE_MODEL_REF=

# ============================================
# Plugins Configuration
# ============================================
# Filesystem directory for plugin packages
PLUGINS_DIR=./var/plugins

# ============================================
# Feature Flags
# ============================================
# Public Community release manifest
PLATFORM_VERSION=1.6.0
PLATFORM_EDITION=community
# Anonymous telemetry: one report a day about yesterday, off unless set
# (docs/telemetry.md lists every field; GET /api/v1/diagnostics/telemetry
# shows the exact report).
# TELEMETRY_ENABLED=false
# What this process serves: all (default) or gateway, which serves only /v1,
# /mcp, /api/v1/tools and health and runs no background work (docs/gateway.md).
# SOIT_ROLE=all
PLATFORM_ENTITLEMENTS=[]
# A signed Enterprise license and the Ed25519 public key that verifies it
# (docs/editions.md). When set, the license decides the edition; an expired
# or unverifiable one leaves the runtime Community. Without them: Community.
# ENTERPRISE_LICENSE_PATH=/etc/soit/license.json
# ENTERPRISE_LICENSE_PUBLIC_KEY_PATH=/etc/soit/license.pub

# Enable egress policy (deny-by-default)
ENABLE_EGRESS_POLICY=true
EGRESS_ALLOWLIST=[]
EGRESS_BLOCKLIST=[]
# Private or loopback networks governed calls may reach (CIDR), such as a local
# Ollama (["127.0.0.1/32"]) or a model server on your network. Each target still
# needs an allowlist entry. Empty refuses every non-public address.
EGRESS_PRIVATE_NETWORKS=[]

# ============================================
# API Configuration
# ============================================
# API v1 prefix
API_V1_PREFIX=/api/v1
# Proxies in front of the API (addresses or CIDR ranges) whose X-Forwarded-For is believed
TRUSTED_PROXIES=[]
# Public URL of the MCP endpoint; empty derives it from the request
MCP_RESOURCE_URL=
# OAuth authorization servers listed in the MCP protected resource metadata
MCP_AUTHORIZATION_SERVERS=[]
# Browser origins, besides the endpoint's own, allowed to call /mcp
MCP_ALLOWED_ORIGINS=[]


# ============================================
# Knowledge Ingest Worker Configuration
# ============================================
KNOWLEDGE_INGEST_WORKER_ENABLED=false
KNOWLEDGE_INGEST_WORKER_POLL_INTERVAL=1.0
# 0 keeps the worker running indefinitely; a positive value exits after that many tasks.
KNOWLEDGE_INGEST_WORKER_MAX_TASKS=0
KNOWLEDGE_INGEST_WORKER_CONCURRENCY=1
KNOWLEDGE_INGEST_WORKER_HEARTBEAT_SECONDS=30
KNOWLEDGE_INGEST_WORKER_LEASE_SECONDS=120

# Knowledge connector syncs (docs/knowledge-connectors.md). The sync worker runs
# wherever the ingest worker does; false turns the sync half off.
KNOWLEDGE_SYNC_WORKER_ENABLED=true
KNOWLEDGE_SYNC_WORKER_POLL_INTERVAL=5.0
KNOWLEDGE_SYNC_WORKER_CONCURRENCY=2
KNOWLEDGE_SYNC_WORKER_LEASE_SECONDS=300
# How often the worker looks for sources whose cron schedule is due.
KNOWLEDGE_SYNC_SCHEDULER_INTERVAL_SECONDS=30
# Shortest allowed gap between two scheduled syncs of one source.
KNOWLEDGE_SYNC_MIN_INTERVAL_SECONDS=300
# A run claimed this many times (crash recovery included) is given up on.
KNOWLEDGE_SYNC_MAX_ATTEMPTS=3
# Per-run caps a source gets by default, and the most it may ask for.
KNOWLEDGE_SYNC_DEFAULT_MAX_ITEMS=1000
KNOWLEDGE_SYNC_MAX_ITEMS_CEILING=20000
KNOWLEDGE_SYNC_DEFAULT_MAX_ITEM_BYTES=5242880
KNOWLEDGE_SYNC_MAX_ITEM_BYTES_CEILING=52428800
KNOWLEDGE_SYNC_DEFAULT_MAX_TOTAL_BYTES=268435456
KNOWLEDGE_SYNC_MAX_TOTAL_BYTES_CEILING=4294967296

# Workflow execution
WORKFLOW_EXECUTION_LEASE_SECONDS=120
# Enable on the API service so interrupted workflow runs fail honestly instead
# of reporting "running" forever.
WORKFLOW_ORPHAN_REAPER_ENABLED=true
WORKFLOW_ORPHAN_REAPER_INTERVAL=30.0

# Enable on the API service so an image job lost with its process fails
# honestly, and the provider call it left in flight is charged.
IMAGE_JOB_REAPER_ENABLED=true
IMAGE_JOB_REAPER_INTERVAL=60.0
IMAGE_JOB_HEARTBEAT_SECONDS=30.0
IMAGE_JOB_ORPHAN_AFTER_SECONDS=600.0

# ============================================
# Event Outbox Configuration
# ============================================
EVENT_OUTBOX_ENABLED=true

# Cross-process live event delivery
EVENT_BUS_BACKEND=redis
EVENT_BUS_REDIS_URL=redis://localhost:6379/0
