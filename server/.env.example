# Application Environment Variables
# Copy this file to .env or .env.local and update with your actual values

PROJECT_NAME="soit"
PROJECT_DESCRIPTION="SOIT is a platform for llm application building"
ENVIRONMENT=development

# ============================================
# Database Configuration
# ============================================
# Database type (postgresql, mysql, etc.)
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=soit_db
DATABASE_USER=your_username
DATABASE_PASS=your_password

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
# How long one access token lasts. The client renews silently against
# /refresh, so this is not the session length -- it is the worst-case delay
# before a revoked session stops working. Keep it short.
#
# REFRESH_TOKEN_EXPIRE_DAYS is the session length: how long a client can keep
# renewing before signing in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ============================================
# Milvus Configuration
# ============================================
# Milvus vector database host
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# Storage Configuration
# ============================================
# S3 STORAGE_OPTIONS_JSON (e.g., {"endpoint_url":"http://minio:9000","key":"soitminio","secret":"soitminio"})
STORAGE_URL=file:///var/soit_storage
STORAGE_OPTIONS_JSON={}
STORAGE_AUTO_MKDIR=true

# ============================================
# Vault Configuration
# ============================================
# HashiCorp Vault URL (optional)
VAULT_URL=
VAULT_TOKEN=

# ============================================
# Observability Configuration
# ============================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=
SENTRY_ENABLED=false


# OpenTelemetry Configuration
OTEL_ENABLED=false
OTEL_SERVICE_NAME=soit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLE_RATIO=1.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=rich
LOG_COLOR=true
LOG_COLOR_FORCE=true

# ============================================
# LLM Provider Configuration
# ============================================
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_LLM_PROVIDER=openai
# Model for LLM-as-judge regression scoring; empty disables the judge
EVALUATION_JUDGE_MODEL_REF=

# ============================================
# Plugins Configuration
# ============================================
# Filesystem directory for plugin packages
PLUGINS_DIR=./var/plugins

# ============================================
# Feature Flags
# ============================================
# Public Community release manifest
PLATFORM_VERSION=1.0.0
PLATFORM_EDITION=community
PLATFORM_ENTITLEMENTS=[]

# Enable egress policy (deny-by-default)
ENABLE_EGRESS_POLICY=true
EGRESS_ALLOWLIST=[]
EGRESS_BLOCKLIST=[]

# ============================================
# API Configuration
# ============================================
# API v1 prefix
API_V1_PREFIX=/api/v1


# ============================================
# Knowledge Ingest Worker Configuration
# ============================================
KNOWLEDGE_INGEST_WORKER_ENABLED=false
KNOWLEDGE_INGEST_WORKER_POLL_INTERVAL=1.0
# 0 keeps the worker running indefinitely; a positive value exits after that many tasks.
KNOWLEDGE_INGEST_WORKER_MAX_TASKS=0
KNOWLEDGE_INGEST_WORKER_CONCURRENCY=1
KNOWLEDGE_INGEST_WORKER_HEARTBEAT_SECONDS=30
KNOWLEDGE_INGEST_WORKER_LEASE_SECONDS=120

# Workflow execution
WORKFLOW_EXECUTION_LEASE_SECONDS=120
# Enable on the API service so interrupted workflow runs fail honestly instead
# of reporting "running" forever.
WORKFLOW_ORPHAN_REAPER_ENABLED=true
WORKFLOW_ORPHAN_REAPER_INTERVAL=30.0

# ============================================
# Event Outbox Configuration
# ============================================
EVENT_OUTBOX_ENABLED=true

# Cross-process live event delivery
EVENT_BUS_BACKEND=redis
EVENT_BUS_REDIS_URL=redis://localhost:6379/0
