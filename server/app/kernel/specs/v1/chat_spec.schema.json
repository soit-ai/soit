{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soit.ai/specs/v1/chat_spec.schema.json",
  "$comment": "SOIT chat runtime spec (v1).",
  "title": "ChatSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "model_ref"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "const": "chat_runtime_v1"
    },
    "system_prompt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "model_ref": {
      "$ref": "refs.schema.json#/$defs/ModelRef"
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 2
    },
    "max_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "top_p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "tools": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "configs": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "tool_refs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "rag": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "refs.schema.json#/$defs/KnowledgeRef"
          }
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "vector",
            "multi_index",
            "keyword",
            "hybrid"
          ]
        },
        "index_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "type": [
            "object",
            "null"
          ]
        },
        "use_rerank": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reranker_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "include_snippets": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "snippet_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 40,
          "maximum": 1000
        },
        "max_snippets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "keyword_top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 200
        },
        "keyword_candidate_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 10,
          "maximum": 10000
        },
        "keyword_min_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "hybrid_alpha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "history_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "ui": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "opening": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "quick_actions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
