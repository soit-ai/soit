{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "adapter",
    "input_schema",
    "output_schema",
    "policy"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapter": {
      "type": "string",
      "enum": [
        "http",
        "function",
        "mcp"
      ]
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "http": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "minLength": 3
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": [
            "object",
            "null"
          ]
        },
        "body_template": {
          "type": [
            "object",
            "null"
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "follow_redirects": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional base URL (used with path)."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional path appended to base URL."
        }
      },
      "required": [
        "method"
      ]
    },
    "function": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string",
          "description": "Function entrypoint reference (e.g. 'pkg.module:func')."
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "python",
            "node",
            "wasm",
            null
          ],
          "description": "Execution runtime hint."
        }
      },
      "required": [
        "entrypoint"
      ]
    },
    "mcp": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "server_ref": {
          "$ref": "refs.schema.json#/$defs/EndpointRef"
        },
        "tool_name": {
          "type": "string",
          "description": "Remote MCP tool name"
        }
      },
      "required": [
        "server_ref",
        "tool_name"
      ]
    },
    "auth": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "api_key",
            "oauth2",
            "signature"
          ]
        },
        "secret_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/SecretId"
          }
        },
        "api_key": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "string",
              "enum": [
                "header",
                "query"
              ]
            },
            "name": {
              "type": "string",
              "description": "Header/query name to carry the api key."
            },
            "secret_id": {
              "$ref": "refs.schema.json#/$defs/SecretId"
            }
          },
          "required": [
            "in",
            "name",
            "secret_id"
          ]
        },
        "signature": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "type": "string",
              "enum": [
                "hmac-sha256",
                "hmac-sha1",
                "rsa-sha256"
              ]
            },
            "secret_id": {
              "$ref": "refs.schema.json#/$defs/SecretId"
            },
            "headers_to_sign": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "algo",
            "secret_id"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_level"
      ],
      "properties": {
        "rate_limit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "rpm": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "egress": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "audit_level": {
          "type": "string",
          "enum": [
            "basic",
            "full"
          ]
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "risk_level"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "required"
              ]
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high",
                "critical"
              ]
            }
          }
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Default execution timeout for this tool."
        },
        "retry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max_retries": {
              "type": "integer",
              "minimum": 0
            },
            "backoff_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "registry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "registry_only": {
              "type": "boolean",
              "description": "If true, tool must be invoked via registry resolution (no raw-http fallback)."
            }
          }
        }
      }
    },
    "endpoint_ref": {
      "type": [
        "string",
        "null"
      ],
      "allOf": [
        {
          "$ref": "refs.schema.json#/$defs/EndpointRef"
        }
      ],
      "description": "Optional gateway/endpoint reference for routing"
    },
    "id": {
      "$ref": "refs.schema.json#/$defs/ToolRef",
      "description": "Stable tool reference id (tool_ref).",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tool spec version (SemVer recommended).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$"
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 32
    }
  },
  "description": "Tool specification for HTTP/Function/MCP adapters.",
  "examples": [
    {
      "name": "ticket_create",
      "adapter": "http",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "http": {
        "method": "POST",
        "url": "https://api.example.com/tickets",
        "headers": {
          "Authorization": "Bearer {{ secrets.api_key }}"
        },
        "body_template": {
          "title": "{{ inputs.title }}"
        }
      },
      "auth": {
        "type": "api_key",
        "secret_ids": [
          "sec_example_api_key"
        ]
      },
      "policy": {
        "rate_limit": {
          "rpm": 60
        },
        "egress": {
          "allow": [
            "api.example.com"
          ]
        },
        "audit_level": "basic"
      }
    }
  ],
  "$id": "https://soit.ai/specs/v1/tool_spec.schema.json",
  "$comment": "SOIT kernel spec schema (v1).",
  "allOf": [
    {
      "oneOf": [
        {
          "title": "HTTP tool",
          "properties": {
            "adapter": {
              "const": "http"
            },
            "http": {
              "type": "object"
            }
          },
          "required": [
            "adapter",
            "http"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "endpoint_ref"
                  ]
                },
                {
                  "properties": {
                    "http": {
                      "required": [
                        "url"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "title": "Function tool",
          "properties": {
            "adapter": {
              "const": "function"
            },
            "function": {
              "type": "object"
            }
          },
          "required": [
            "adapter",
            "function"
          ]
        },
        {
          "title": "MCP tool",
          "properties": {
            "adapter": {
              "const": "mcp"
            },
            "mcp": {
              "type": "object"
            }
          },
          "required": [
            "adapter",
            "mcp"
          ]
        }
      ]
    },
    {
      "title": "Auth config binding",
      "if": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "const": "api_key"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "required": [
              "api_key"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "const": "signature"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "required": [
              "signature"
            ]
          }
        }
      }
    }
  ]
}
