{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunTraceSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "steps"
  ],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "tenant_id",
        "workspace_id",
        "mode",
        "status",
        "started_at"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": ["string", "null"]
        },
        "parent_run_id": {
          "type": ["string", "null"]
        },
        "source_run_id": {
          "type": ["string", "null"]
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "description": "Domain-specific execution mode (e.g., chat, knowledge_ingest)."
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "chat",
            "workflow",
            "agent",
            "tool",
            "batch",
            "response",
            "knowledge",
            "memory",
            "evaluation",
            null
          ]
        },
        "subject_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "preparing",
            "running",
            "waiting_input",
            "waiting_approval",
            "paused",
            "retrying",
            "succeeded",
            "failed",
            "canceled",
            "expired"
          ]
        },
        "input_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "output_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_step_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step_type",
          "status",
          "started_at"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "step_type": {
            "type": "string",
            "enum": [
              "llm",
              "retrieval",
              "rerank",
              "tool",
              "workflow_node",
              "agent_plan",
              "memory_write",
              "io",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "preparing",
              "running",
              "waiting_input",
              "waiting_approval",
              "paused",
              "retrying",
              "succeeded",
              "failed",
              "skipped",
              "canceled",
              "expired"
            ]
          },
          "input_summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "output_summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "metrics": {
            "type": [
              "object",
              "null"
            ],
            "description": "tokens/latency/http_status/vector_count etc."
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "type",
          "storage_key",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "log",
              "blob",
              "json"
            ]
          },
          "storage_key": {
            "type": "string"
          },
          "mime": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "meta": {
            "type": [
              "object",
              "null"
            ],
            "description": "mime/size/hash"
          }
        }
      }
    },
    "entries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cost_id",
          "run_id",
          "entry_type",
          "unit",
          "quantity",
          "pricing_snapshot_json"
        ],
        "properties": {
          "cost_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "entry_type": {
            "type": "string",
            "enum": ["usage", "charge"],
            "description": "New records use usage; charge is retained only for historical exports."
          },
          "currency": {
            "type": ["string", "null"]
          },
          "amount": {
            "type": ["number", "null"]
          },
          "pricing_snapshot_json": {
            "type": "object",
            "description": "Immutable original and normalized pricing configuration used to calculate this record."
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_id": {
            "type": ["string", "null"]
          },
          "provider_slug": {
            "type": ["string", "null"]
          },
          "provider_kind": {
            "type": ["string", "null"]
          },
          "model_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_model": {
            "type": ["string", "null"]
          },
          "tool_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "completion_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "usage_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens_prompt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_completion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "embedding_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rerank_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ms_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "storage_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "charge_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["entry_count", "amounts"],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "amounts": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  },
  "description": "Unified execution trace container where one usage record may include monetary cost and immutable pricing evidence.",
  "examples": [
    {
      "run": {
        "run_id": "run_01H...",
        "tenant_id": "t_01H...",
        "workspace_id": "w_01H...",
        "mode": "workflow",
        "kind": "workflow",
        "status": "succeeded",
        "started_at": "2025-01-01T00:00:00Z"
      },
      "steps": [
        {
          "step_id": "st_01H...",
          "step_type": "retrieval",
          "status": "succeeded",
          "started_at": "2025-01-01T00:00:01Z",
          "metrics": {
            "top_k": 5,
            "latency_ms": 120
          }
        }
      ],
      "usage_summary": {
        "tokens_prompt": 120,
        "tokens_completion": 350,
        "ms_total": 2300
      }
    }
  ],
  "$id": "https://soit.ai/specs/v1/runtrace_spec.schema.json",
  "$comment": "SOIT kernel spec schema (v1)."
}
