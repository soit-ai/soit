{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soit.ai/specs/v1/refs.schema.json",
  "title": "SOIT Reference Models",
  "type": "object",
  "description": "Shared reference string models used across SOIT specs. All are strings with prefixes.",
  "$defs": {
    "RefString": {
      "type": "string",
      "minLength": 3,
      "description": "Generic reference string with a namespace prefix."
    },
    "ModelRef": {
      "type": "string",
      "pattern": "^model:[A-Za-z0-9_.-]+:[A-Za-z0-9_.:-]+$",
      "description": "Model reference. Format: model:{provider}:{model_name_or_id}"
    },
    "KnowledgeRef": {
      "type": "string",
      "pattern": "^knowledge:[A-Za-z0-9_.:-]+$",
      "description": "Knowledge reference. Preferred format: knowledge:{knowledge_id_or_key}."
    },
    "ToolRef": {
      "type": "string",
      "pattern": "^tool:(http|function|mcp):[A-Za-z0-9_.:-]+$",
      "description": "Tool reference. Format: tool:{adapter}:{tool_name_or_id}"
    },
    "NodeRef": {
      "type": "string",
      "pattern": "^node:[A-Za-z0-9_.-]+:[A-Za-z0-9_.:-]+$",
      "description": "Workflow node reference. Format: node:{adapter}:{node_name_or_id}"
    },
    "WorkflowRef": {
      "type": "string",
      "pattern": "^wf:[A-Za-z0-9_.:-]+$",
      "description": "Workflow reference. Format: wf:{workflow_id_or_key}"
    },
    "SkillRef": {
      "type": "string",
      "pattern": "^skill:[A-Za-z0-9_.:-]+$",
      "description": "Skill reference. Format: skill:{skill_id_or_key}"
    },
    "SecretRef": {
      "type": "string",
      "pattern": "^secret:[A-Za-z0-9_.:-]+$",
      "description": "Secret reference. Format: secret:{secret_name_or_id}"
    },
    "EndpointRef": {
      "type": "string",
      "pattern": "^(endpoint|gw):[A-Za-z0-9_.:-]+$",
      "description": "Endpoint/route reference. Format: endpoint:{name} or gw:{name}"
    },
    "PolicyRef": {
      "type": "string",
      "pattern": "^(policy|quota|guardrails):[A-Za-z0-9_.:-]+$",
      "description": "Policy reference. Format: policy/quota/guardrails:{name_or_id}"
    },
    "ULID": {
      "type": "string",
      "description": "ULID (Crockford Base32, 26 chars).",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "TenantId": {
      "type": "string",
      "description": "Tenant identifier.",
      "minLength": 1,
      "maxLength": 128
    },
    "WorkspaceId": {
      "type": "string",
      "description": "Workspace identifier within a tenant.",
      "minLength": 1,
      "maxLength": 128
    },
    "PluginRef": {
      "type": "string",
      "description": "Plugin reference. Format: plugin:{publisher}:{name}:{version}",
      "pattern": "^plugin:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.:-]+$"
    },
    "MCPServerRef": {
      "type": "string",
      "pattern": "^mcp_server:[A-Za-z0-9_.:-]+$",
      "description": "MCP server reference. Format: mcp_server:{server_id_or_key}"
    },
    "MCPToolRef": {
      "type": "string",
      "pattern": "^mcp_tool:[A-Za-z0-9_.:-]+$",
      "description": "MCP tool reference. Format: mcp_tool:{server_or_catalog_key}"
    },
    "MCPResourceRef": {
      "type": "string",
      "pattern": "^mcp_resource:[A-Za-z0-9_.:-]+$",
      "description": "MCP resource reference. Format: mcp_resource:{server_or_catalog_key}"
    }
  },
  "$comment": "SOIT kernel spec schema (v1)."
}
