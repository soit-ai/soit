{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soit.ai/specs/v1/agent_spec.schema.json",
  "$comment": "SOIT agent runtime spec (v1).",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "bindings"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "const": "agent_runtime_v1"
    },
    "system_prompt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "planner": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "params": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 2
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "knowledge_refs",
        "tool_refs",
        "workflow_refs",
        "skill_refs"
      ],
      "properties": {
        "model_ref": {
          "$ref": "refs.schema.json#/$defs/ModelRef"
        },
        "knowledge_refs": {
          "type": "array",
          "items": {
            "$ref": "refs.schema.json#/$defs/KnowledgeRef"
          }
        },
        "tool_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow_refs": {
          "type": "array",
          "items": {
            "$ref": "refs.schema.json#/$defs/WorkflowRef"
          }
        },
        "skill_refs": {
          "type": "array",
          "items": {
            "$ref": "refs.schema.json#/$defs/SkillRef"
          }
        }
      }
    },
    "memory": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50
        },
        "max_tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "max_llm_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 200
        },
        "max_failures": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "rag_top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 50
        },
        "context_window_messages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 200
        },
        "context_window_chars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "policies": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
