{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soit.ai/specs/v1/workflow_spec.schema.json",
  "$comment": "SOIT kernel workflow spec schema (v1).",
  "title": "WorkflowSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "graph",
    "inputs_schema",
    "outputs_schema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional spec version string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs_schema": {
      "type": "object",
      "description": "JSON Schema for workflow inputs"
    },
    "outputs_schema": {
      "type": "object",
      "description": "JSON Schema for workflow outputs"
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_steps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": [
            "string",
            "null"
          ],
          "description": "Runtime engine identifier (e.g. workflow_engine_v1)"
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "params"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "type": "object",
                "description": "Node parameters payload"
              },
              "ui": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "UI metadata (position/group/color)"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "from_port": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to_port": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Conditional expression for routing"
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_only_tools": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "If true, tool nodes must use registry tool_ref (no raw-http)."
        },
        "default_timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "default_retry_policy": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max_retries": {
              "type": "integer",
              "minimum": 0
            },
            "backoff_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "semantics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "on_error": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "fail_fast",
            "continue",
            "compensate"
          ]
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pause_poll_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100
        }
      }
    }
  },
  "description": "Immutable workflow spec with graph projection and runtime constraints."
}
