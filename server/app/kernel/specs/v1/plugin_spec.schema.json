{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "publisher",
    "version",
    "runtime_level",
    "capabilities",
    "exports",
    "permissions",
    "integrity"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "SemVer recommended"
    },
    "plugin_type": {
      "type": "string",
      "enum": [
        "skill",
        "mcp",
        "tool",
        "workflow_node",
        "mixed"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tools",
          "workflow_nodes",
          "models",
          "retrievers",
          "parsers",
          "ui",
          "skills",
          "mcp_servers"
        ]
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/ToolRef"
          }
        },
        "workflow_nodes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/NodeRef"
          }
        },
        "skills": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/SkillRef"
          }
        },
        "mcp_servers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/MCPServerRef"
          }
        },
        "models": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/ModelRef"
          }
        },
        "retrievers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/RefString"
          }
        },
        "parsers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/RefString"
          }
        },
        "ui": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/RefString"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "storage": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "read": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "secrets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "refs.schema.json#/$defs/SecretId"
          }
        }
      }
    },
    "dependencies": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "sha256:..."
        },
        "signature": {
          "type": [
            "string",
            "null"
          ],
          "description": "Detached signature if applicable"
        }
      }
    },
    "id": {
      "$ref": "refs.schema.json#/$defs/PluginRef",
      "type": [
        "string",
        "null"
      ],
      "description": "Optional stable plugin reference."
    },
    "compatibility": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "min_platform_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_platform_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "requires_features": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "refs.schema.json#/$defs/ToolRef"
          },
          "patternProperties": {
            "^tool:(http|function|mcp):[A-Za-z0-9_.:-]+$": {
              "type": "string",
              "description": "Relative path to tool spec JSON within the plugin package."
            }
          }
        },
        "workflow_nodes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "refs.schema.json#/$defs/NodeRef"
          },
          "patternProperties": {
            "^node:[A-Za-z0-9_.-]+:[A-Za-z0-9_.:-]+$": {
              "type": "string",
              "description": "Relative path to workflow node spec JSON within the plugin package."
            }
          }
        },
        "skills": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "refs.schema.json#/$defs/SkillRef"
          },
          "patternProperties": {
            "^skill:[A-Za-z0-9_.:-]+$": {
              "type": "string",
              "description": "Relative path to skill artifact JSON within the plugin package."
            }
          }
        },
        "mcp_servers": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "refs.schema.json#/$defs/MCPServerRef"
          },
          "patternProperties": {
            "^mcp_server:[A-Za-z0-9_.:-]+$": {
              "type": "string",
              "description": "Relative path to MCP server artifact JSON within the plugin package."
            }
          }
        },
        "ui": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "stable",
            "canary"
          ]
        },
        "rollout_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "description": "Plugin package manifest for marketplace distribution.",
  "examples": [
    {
      "name": "soit-plugin-zendesk",
      "publisher": "soit",
      "version": "1.0.0",
      "runtime_level": "L0",
      "capabilities": [
        "tools"
      ],
      "exports": {
        "tools": [
          "tool:http:ticket_create"
        ]
      },
      "permissions": {
        "network": [
          "api.zendesk.com"
        ],
        "secrets": [
          "sec_zendesk_token"
        ]
      },
      "integrity": {
        "digest": "sha256:..."
      }
    }
  ],
  "$id": "https://soit.ai/specs/v1/plugin_spec.schema.json",
  "$comment": "SOIT kernel spec schema (v1)."
}
