### Backend (server/)
ENVIRONMENT=development
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_PUBLISHED_PORT=5432
DATABASE_USER=soit
DATABASE_PASS=soit
DATABASE_NAME=soit

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

SECRET_KEY=change-me

MILVUS_HOST=milvus
MILVUS_PORT=19530


STORAGE_URL=s3://soit-artifacts
STORAGE_OPTIONS_JSON={"endpoint_url":"http://minio:9000","key":"soitminio","secret":"soitminio"}
STORAGE_AUTO_MKDIR=true
MINIO_ACCESS_KEY=soitminio
MINIO_SECRET_KEY=soitminio
MINIO_BUCKET=soit-artifacts
MINIO_API_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001

VAULT_URL=
VAULT_TOKEN=
VAULT_DEV_ROOT_TOKEN_ID=soit-vault-root

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_LLM_PROVIDER=openai

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=rich
LOG_COLOR=true
LOG_COLOR_FORCE=true

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=soit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLE_RATIO=1.0

# Knowledge ingest worker
KNOWLEDGE_INGEST_WORKER_ENABLED=false
KNOWLEDGE_INGEST_WORKER_POLL_INTERVAL=1.0
# 0 keeps the worker running indefinitely; a positive value exits after that many tasks.
KNOWLEDGE_INGEST_WORKER_MAX_TASKS=0
KNOWLEDGE_INGEST_WORKER_CONCURRENCY=1

# Bootstrap admin (compose job)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_TENANT_NAME=default

# Event bus
EVENT_BUS_BACKEND=redis
EVENT_BUS_REDIS_URL=redis://redis:6379/0
EVENT_BUS_CHANNEL=soit:events

# Plugins / Marketplace
PLATFORM_VERSION=1.0.0
PLATFORM_EDITION=community
PLATFORM_ENTITLEMENTS=[]
# Production requires all three: signatures enforced, at least one trusted key,
# and digest verification. Startup fails otherwise.
PLUGIN_SIGNATURE_REQUIRED=false
PLUGIN_SIGNATURE_PUBLIC_KEYS=[]
PLUGIN_INTEGRITY_REQUIRED=false
# Package digests refused on install even when correctly signed.
PLUGIN_REVOKED_PACKAGE_DIGESTS=[]

# Governed egress
ENABLE_EGRESS_POLICY=true
EGRESS_ALLOWLIST=[]
EGRESS_BLOCKLIST=[]

### Frontend (web/) - build time
VITE_BASE_URL=http://localhost:9200/api/v1
