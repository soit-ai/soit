### Backend (app/)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=soit
DATABASE_PASS=soit
DATABASE_NAME=soit

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

SECRET_KEY=change-me

MILVUS_HOST=milvus
MILVUS_PORT=19530

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=soitminio
MINIO_SECRET_KEY=soitminio
MINIO_BUCKET=soit-artifacts
MINIO_SECURE=false

VAULT_URL=
VAULT_TOKEN=
VAULT_DEV_ROOT_TOKEN_ID=soit-vault-root

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_PROVIDER=openai

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=rich
LOG_COLOR=true
LOG_COLOR_FORCE=true

# Dataset ingest worker
DATASET_INGEST_WORKER_ENABLED=false
DATASET_INGEST_WORKER_POLL_INTERVAL=1.0
DATASET_INGEST_WORKER_MAX_TASKS=
DATASET_INGEST_WORKER_CONCURRENCY=1

# Bootstrap admin (compose job)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_TENANT_NAME=default

# Event bus
EVENT_BUS_BACKEND=memory
EVENT_BUS_REDIS_URL=
EVENT_BUS_CHANNEL=soit:events

# Plugins / Marketplace
PLATFORM_VERSION=0.1.0
PLATFORM_FEATURES=[]
PLUGIN_SIGNATURE_REQUIRED=false
PLUGIN_SIGNATURE_PUBLIC_KEYS=[]
PLUGIN_INTEGRITY_REQUIRED=false

### Frontend (web/) - build time
VITE_BASE_URL=http://localhost:9200/api/v1
